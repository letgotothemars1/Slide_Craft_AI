BASE_URL=http://localhost:8000
PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/slidecraft
STORAGE_PATH=storage
STORAGE_TEMP_PATH=storage_tmp

# Optional Supabase Storage (if empty -> local storage mode /files/*)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=presentations

# Required for LLM spec generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional image generation (enabled when OPENAI_API_KEY + OPENAI_IMAGE_MODEL are set)
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_BACKGROUND=opaque

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Worker LLM: per-slide HTML rendering (optional, disabled by default)
WORKER_LLM_ENABLED=false
OPENAI_WORKER_MODEL=
